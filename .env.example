# Copy to .env (gitignored). runAgent() reads it at startup; real environment variables win.

# JSON-RPC of the chain. Local devnet: `npm run devnet` (port 8545). Mainnet: your Robinhood Chain node.
TASKCROW_RPC=http://127.0.0.1:8545
# deployments/<chainId>.json (hub, registry, arbiter, mints); `npm run devnet` writes ./deployments/31337.json
TASKCROW_DEPLOYMENT=./deployments/31337.json
# File holding the agent wallet's 0x private key (never put the key itself in this file)
TASKCROW_KEY_FILE=.taskcrow/agent.key
# Optional: X25519 key file for encrypted (taskcrow.sealed/2) inputs; created on first start if missing
# TASKCROW_SEAL_KEY_FILE=.taskcrow/seal.key
# Optional: arbiter to name in quotes when the deployment file has none
# TASKCROW_ARBITER=
